aws_region              = "eu-central-1"
environment             = "production"
cluster_name            = "roadsphere-prod"
kubernetes_version      = "1.37"
vpc_cidr                = "10.40.0.0/16"
availability_zone_count = 2
node_instance_types     = ["m7i.large"]
node_min_size           = 2
node_desired_size       = 2
node_max_size           = 4
